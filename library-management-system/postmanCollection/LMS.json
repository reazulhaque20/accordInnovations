{
  "info": {
    "name": "Library Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Books",
      "item": [
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8181/library/api/v1/books?page=0&size=10&sortBy=title&sortDir=ASC",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8181",
              "path": ["library", "api", "v1", "books"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sortBy",
                  "value": "title"
                },
                {
                  "key": "sortDir",
                  "value": "ASC"
                }
              ]
            }
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8181/library/api/v1/books/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8181",
              "path": ["library", "api", "v1", "books", "1"]
            }
          }
        },
        {
          "name": "Create Book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Book\",\n  \"isbn\": \"1234567890123\",\n  \"publicationYear\": 2023,\n  \"genre\": \"Fiction\",\n  \"quantity\": 5\n}"
            },
            "url": {
              "raw": "http://localhost:8181/library/api/v1/books",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8181",
              "path": ["library", "api", "v1", "books"]
            }
          }
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Book Title\",\n  \"isbn\": \"1234567890123\",\n  \"publicationYear\": 2023,\n  \"genre\": \"Updated Genre\",\n  \"quantity\": 10\n}"
            },
            "url": {
              "raw": "http://localhost:8181/library/api/v1/books/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8181",
              "path": ["library", "api", "v1", "books", "1"]
            }
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:8181/library/api/v1/books/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8181",
              "path": ["library", "api", "v1", "books", "1"]
            }
          }
        },
        {
          "name": "Search Books",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Harry Potter\",\n  \"genre\": \"Fantasy\",\n  \"page\": 0,\n  \"size\": 10,\n  \"sortBy\": \"title\",\n  \"sortDirection\": \"ASC\"\n}"
            },
            "url": {
              "raw": "http://localhost:8181/library/api/v1/books/search",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8181",
              "path": ["library", "api", "v1", "books", "search"]
            }
          }
        },
        {
          "name": "Get Books with Active Loans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8181/library/api/v1/books/loans/active",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8181",
              "path": ["library", "api", "v1", "books", "loans", "active"]
            }
          }
        }
      ]
    },
    {
      "name": "External APIs",
      "item": [
        {
          "name": "Search Google Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8181/library/api/v1/books/external/search?query=java+programming",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8181",
              "path": ["library", "api", "v1", "books", "external", "search"],
              "query": [
                {
                  "key": "query",
                  "value": "java+programming"
                }
              ]
            }
          }
        },
        {
          "name": "Call External API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8181/library/api/v1/books/external/call?url=https://jsonplaceholder.typicode.com/posts/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8181",
              "path": ["library", "api", "v1", "books", "external", "call"],
              "query": [
                {
                  "key": "url",
                  "value": "https://jsonplaceholder.typicode.com/posts/1"
                }
              ]
            }
          }
        }
      ]
    }
  ]
